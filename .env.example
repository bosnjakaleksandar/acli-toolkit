# A-CLI does not load .env files. These are plain process environment
# variables you may export yourself; none are required for normal use.

# Runtime flags (equivalent to --verbose / --debug / --quiet)
# ACLI_VERBOSE=1
# ACLI_DEBUG=1
# ACLI_QUIET=1

# Override the platform config directory (see `acli config path`)
# ACLI_CONFIG_HOME=/custom/path

# Disable animations/color (also auto-detected for CI, NO_COLOR, TERM=dumb)
# ACLI_REDUCED_MOTION=1
# NO_COLOR=1

# Default starter-theme repo/branches for `acli create --type wordpress`
# (per-project overrides belong in a preset or profile, not here)
# WP_THEME_REPO=git@github.com:your-org/starter-theme.git
# WP_WOO_BRANCH=woocommerce
# WP_REACT_BRANCH=react

# One-time bridge for `acli profile import-legacy`, which reproduces the
# pre-v2 create-project staging convention (SSH user == project name,
# remote path ~/<project>/wordpress) as a reusable profile. Not used
# anywhere else.
# STAGING_SSH_HOST=your-staging-host
# STAGING_SUFFIX=.staging
