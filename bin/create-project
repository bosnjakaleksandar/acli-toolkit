#!/usr/bin/env node

import { run } from "../src/cli/run.js";
import { BRANDING } from "../src/config/branding.js";

try {
  console.warn(`Warning: 'create-project' is deprecated. Use '${BRANDING.command} create' instead.\n`);
  await run(process.argv, { legacyExecutable: true });
} catch (error) {
  console.error(error instanceof Error ? error.message : error);
  process.exitCode = 1;
}
